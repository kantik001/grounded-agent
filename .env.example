PORT=8000
LOG_LEVEL=info

# OpenAI-compatible LLM (required for live agent)
LLM_BASE_URL=https://openrouter.ai/api
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Grounded LLM retrieval (gRPC preferred; http fallback for tests)
RETRIEVE_MODE=grpc
GROUNDED_GRPC_ADDR=localhost:50051
RAG_HTTP_URL=http://localhost:5000
RAG_SERVICE_TOKEN=
DEFAULT_DOMAIN_ID=default
DEFAULT_TENANT_ID=default
DEFAULT_LOCALE=en

# MCP Gateway
MCP_GATEWAY_URL=http://localhost:8080
MCP_API_KEY=

# Redis session memory
REDIS_URL=redis://localhost:6379/0
MEMORY_MAX_PAIRS=10
MEMORY_TTL_MINUTES=30

# ReAct
REACT_MAX_STEPS=5
